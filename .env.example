# Copy this file to .env.local for local development (never commit .env.local).
# CI receives these via GitHub Encrypted Secrets — no .env file is written to the runner.

# URL of the deployed Cloudflare Workers leaderboard API.
# Leave empty to disable the leaderboard client (game still runs fully offline).
VITE_LEADERBOARD_URL=https://strike-zone-2-leaderboard.workers.dev
